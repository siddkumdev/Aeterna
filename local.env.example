# Copy this file to local.env (same folder) and fix the paths for YOUR machine.
# local.env is git-ignored: each person keeps their own. Check it with:  python tools/doctor.py
BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
# Godot is a portable download: point at the *_console.exe inside the folder you unzipped
GODOT_EXE=C:\Users\<you>\Downloads\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64_console.exe
# Meta XR Simulator runtime (used only by godot\run_sim.ps1, for that process; never set it system-wide)
META_XR_SIM_JSON=C:\Program Files\MetaXRSimulator\v207.1\meta_openxr_simulator.json
# Laptop on the same network as the watch, used as a bridge by watch/watch_bridge.py (optional)
WATCH_BRIDGE=the-tank@100.95.40.122
