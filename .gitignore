# personal machine paths (each person has their own; see local.env.example)
local.env
# scratch
_work/
# Blender backups, Python caches
*.blend1
__pycache__/
*.pyc
# Godot import cache (rebuilt by: python tools/sync_to_godot.py --check)
godot/.godot/
# personal Claude Code settings (shared ones are in .claude/settings.json)
.claude/settings.local.json
# Quest build (2026-11-10): OpenXR Vendors plugin binaries (82 MB, GodotVR 5.1.0-stable) and the
# Android Gradle build template are per-machine for now; see docs/QUEST_BUILD.md to recreate them
godot/addons/godotopenxrvendors/
godot/android/
watch/build/
watch/.gradle/
watch/local.properties
# Local Codex-compatible copies of the Claude skills/agents/config; not shared.
.agents/
.codex/
